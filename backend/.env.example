# ==========================================================
# Prescriptive Maintenance Assistant - Backend Configuration
# ==========================================================
# No paid API keys are required anywhere in this project.
# The LLM runs locally through Ollama (free & offline-capable).
# Embeddings run locally through Sentence-Transformers (free).
# ChromaDB is a local, embedded vector database (free).
# ==========================================================

# --- LLM (Ollama - local, free) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Embeddings (Sentence-Transformers - local, free) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=maintenance_manuals

# --- Document paths ---
MANUALS_DIR=./data/manuals
INVENTORY_FILE=./data/inventory.json

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
RETRIEVAL_TOP_K=4

# --- API ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
